# Development uses SQLite if DATABASE_URL is omitted.
# Production requires hosted PostgreSQL with TLS. Never commit credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/postgres?sslmode=require
# SIGNAL_ENV=production
# SIGNAL_WORKSPACE_USER=signal
# SIGNAL_WORKSPACE_PASSWORD=
# SIGNAL_SCHEDULER_SECRET=
# SIGNAL_BACKEND_URL=https://YOUR-BACKEND.vercel.app
# SIGNAL_CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app

# Enable a route only after verifying this key belongs to a free-only project.
# GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=0
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_DAILY_TOKEN_BUDGET=40000

# GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=0
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_MODEL=gemini-3.1-flash-lite
GEMINI_DAILY_TOKEN_BUDGET=40000
SIGNAL_EMBEDDINGS=0

# OPENROUTER_API_KEY=
OPENROUTER_FREE_TIER_CONFIRMED=0
OPENROUTER_FAST_MODEL=openrouter/free
OPENROUTER_REASONING_MODEL=openrouter/free
OPENROUTER_DAILY_TOKEN_BUDGET=40000

# Local workers only. Production runs scheduled, bounded HTTP invocations.
SIGNAL_AUTO_REFRESH=1
SIGNAL_LOCAL_WORKER=1
SIGNAL_MATCH_WEIGHTS=0.30,0.25,0.25,0.10,0.10

# Backend only. Set these in Render, not in NEXT_PUBLIC variables.
# DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/postgres?sslmode=require
# SIGNAL_ENV=production
# SIGNAL_RUN_MIGRATIONS=1
# SIGNAL_ANALYST_TOKEN=
# SIGNAL_SCHEDULER_SECRET=
# SIGNAL_CORS_ORIGINS=https://signal-intelligence-engine.vercel.app

# Choose an eligible free-only account. Optional fallback keys use provider-specific settings.
LLM_PROVIDER=groq
# LLM_API_KEY=
LLM_FREE_TIER_CONFIRMED=0
# LLM_MODEL=
ASSISTANT_MODEL=openai/gpt-oss-20b
FORECAST_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=  # Required only for LLM_PROVIDER=compatible. HTTPS OpenAI-style /v1 base.
GROQ_DAILY_TOKEN_BUDGET=40000
# GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=0
# GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=0
GEMINI_DAILY_TOKEN_BUDGET=40000
# OPENROUTER_API_KEY=
OPENROUTER_FREE_TIER_CONFIRMED=0
OPENROUTER_DAILY_TOKEN_BUDGET=40000
SIGNAL_EMBEDDINGS=0

SIGNAL_ASSISTANT_PER_HOUR=30
SIGNAL_FORECAST_PER_HOUR=12
SIGNAL_EVIDENCE_PER_HOUR=30
SIGNAL_MATCH_WEIGHTS=0.30,0.25,0.25,0.10,0.10
SIGNAL_AUTO_REFRESH=1
SIGNAL_LOCAL_WORKER=1

# Frontend only. Public origin on Vercel (defaults to this Render service when hosted).
# NEXT_PUBLIC_API_URL=https://signal-intelligence-engine.onrender.com
